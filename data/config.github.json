{
  "ai": {
    "provider": "deepseek",
    "model": "deepseek-v4-flash",
    "base_url": "https://api.deepseek.com",
    "api_key_env": "DEEPSEEK_API_KEY",
    "temperature": 0.3,
    "max_tokens": 8192,
    "throttle_sec": 1,
    "analysis_concurrency": 3,
    "enrichment_concurrency": 2,
    "languages": [
      "zh"
    ]
  },
  "processing": {
    "profiles_dir": "profiles",
    "default_profile": "ai-creator",
    "profile_settings": {
      "ai-creator": {
        "threshold": 7,
        "topic_dedup": true
      }
    }
  },
  "sources": {
    "github": [
      {
        "type": "repo_releases",
        "owner": "langgenius",
        "repo": "dify",
        "enabled": true,
        "category": "ai-product",
        "profile": "ai-creator"
      },
      {
        "type": "repo_releases",
        "owner": "langchain-ai",
        "repo": "langchain",
        "enabled": true,
        "category": "agent",
        "profile": "ai-creator"
      },
      {
        "type": "repo_releases",
        "owner": "huggingface",
        "repo": "transformers",
        "enabled": true,
        "category": "model",
        "profile": "ai-creator"
      },
      {
        "type": "repo_releases",
        "owner": "ComfyUI",
        "repo": "ComfyUI",
        "enabled": true,
        "category": "video-generation",
        "profile": "ai-creator"
      }
    ],
    "hackernews": {
      "enabled": true,
      "fetch_top_stories": 30,
      "min_score": 100,
      "category": "ai-industry",
      "profile": "ai-creator"
    },
    "rss": [
      {
        "name": "Simon Willison",
        "url": "https://simonwillison.net/atom/everything/",
        "enabled": true,
        "category": "ai-tools",
        "profile": "ai-creator"
      },
      {
        "name": "vLLM Blog",
        "url": "https://vllm.ai/blog/rss.xml",
        "enabled": true,
        "category": "model",
        "profile": "ai-creator"
      },
      {
        "name": "GitHub Trending - Daily",
        "url": "https://mshibanami.github.io/GitHubTrendingRSS/daily/all.xml",
        "enabled": true,
        "category": "oss",
        "profile": "ai-creator"
      },
      {
        "name": "Semianalysis",
        "url": "https://newsletter.semianalysis.com/feed",
        "enabled": true,
        "category": "ai-commercialization",
        "profile": "ai-creator"
      }
    ],
    "reddit": {
      "enabled": true,
      "subreddits": [
        {
          "subreddit": "MachineLearning",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 12,
          "min_score": 50,
          "category": "model",
          "profile": "ai-creator"
        },
        {
          "subreddit": "LocalLLaMA",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 12,
          "min_score": 50,
          "category": "oss",
          "profile": "ai-creator"
        }
      ],
      "users": [],
      "fetch_comments": 8
    },
    "telegram": {
      "enabled": true,
      "channels": [
        {
          "channel": "zaihuapd",
          "enabled": true,
          "fetch_limit": 20,
          "category": "ai-industry",
          "profile": "ai-creator"
        }
      ]
    },
    "ossinsight": {
      "enabled": true,
      "period": "past_24_hours",
      "languages": [
        "All",
        "Python",
        "TypeScript"
      ],
      "keywords": [
        "AI",
        "agent",
        "LLM",
        "video",
        "model"
      ],
      "min_stars": 20,
      "max_items": 20,
      "category": "oss",
      "profile": "ai-creator"
    },
    "google_news": {
      "enabled": true,
      "query": "artificial intelligence OR AI agent OR generative AI OR video generation",
      "language": "en",
      "country": "US",
      "ceid": null,
      "max_results": 40,
      "category": "ai-industry",
      "profile": "ai-creator"
    },
    "twitter": {
      "enabled": false,
      "users": [],
      "fetch_limit": 0,
      "profile": "ai-creator"
    }
  },
  "collection": {
    "time_window_hours": 24
  },
  "digest": {
    "max_items": 15,
    "profile_order": [
      "ai-creator"
    ],
    "category_groups": {
      "product": {
        "name": "AI 产品与商业化",
        "limit": 4,
        "categories": [
          "ai-product",
          "ai-commercialization"
        ]
      },
      "technology": {
        "name": "模型与 Agent",
        "limit": 5,
        "categories": [
          "model",
          "agent"
        ]
      },
      "tools": {
        "name": "开源工具与视频生成",
        "limit": 4,
        "categories": [
          "oss",
          "ai-tools",
          "video-generation"
        ]
      },
      "industry": {
        "name": "行业动态",
        "limit": 3,
        "categories": [
          "ai-industry"
        ]
      }
    },
    "default_group": "industry",
    "default_group_limit": 2
  },
  "webhook": {
    "enabled": true,
    "url_env": "HORIZON_WEBHOOK_URL",
    "delivery": "summary_and_items",
    "overview_position": "last",
    "platform": "generic",
    "layout": "markdown",
    "fallback_layout": "markdown",
    "languages": [
      "zh"
    ],
    "request_body": {
      "msgtype": "markdown",
      "markdown": {
        "title": "Horizon #{date} AI日报",
        "text": "## Horizon AI日报｜#{date}\n\n本次精选：#{important_items}/#{all_items}\n\n#{summary?limit=18000&split=---}\n\n> Horizon"
      }
    },
    "headers": ""
  }
}
